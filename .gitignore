# Machine-specific configuration and credentials
database.local.json
*.local.json
.env
.env.*
!.env.example

# Local environments, IDE state and Python caches
.venv/
.idea/
.vscode/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

