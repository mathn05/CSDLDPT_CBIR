/tests/
/test_*.py
/check_*.py
/debug_*.py
/profile_*.py
.coverage
.coverage.*
coverage.xml
htmlcov/

# Generated reports, temporary documents, logs and recovery snapshots
/output/
/tmp/
/reports/
/notes/
*.local.md
*.log
*.tmp
*.bak

# Runtime artifacts and large weights are supplied/generated separately
/flower_cbir/data/
/flower_cbir/models/*
